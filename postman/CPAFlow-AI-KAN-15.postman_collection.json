{
	"info": {
		"_postman_id": "cpaflow-ai-kan15-collection",
		"name": "CPAFlow AI — KAN-15 Record Tracking Click and Redirect",
		"description": "End-to-end Postman verification for KAN-15: Record tracking click and redirect.\n\nTests the public redirect route GET /t/{code} with 302 redirect, click persistence, UTM passthrough, IP privacy, and URL safety.\nUses real HTTP requests against the local CPAFlow API.\nRun with: npx newman run <collection> -e <env> --ignore-redirects",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [],
