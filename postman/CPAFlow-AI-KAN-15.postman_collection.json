		{
			"name": "01 — Redirect (Active Campaign)",
			"item": [
				{
					"name": "Active Campaign — 302 Redirect to destination_url",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('status is 302', function () { pm.response.to.have.status(302); });",
									"pm.test('Location header equals destination_url', function () {",
									"    pm.response.to.have.header('Location');",
									"    var location = pm.response.headers.get('Location');",
									"    pm.expect(location).to.eql(pm.environment.get('kan15_offer_destination_url'));",
									"});",
									"pm.test('no authentication required', function () {",
									"    pm.response.to.not.have.header('Authorization');",
									"});"
								]
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [
							{ "key": "Accept", "value": "text/html" }
						],
						"url": {
							"raw": "{{base_url}}/t/{{kan15_active_tracking_code}}",
							"host": ["{{base_url}}"],
							"path": ["t", "{{kan15_active_tracking_code}}"]
						}
					},
					"response": []
				}
			]
		},
		{
			"name": "02 — Redirect with UTM Parameters",
			"item": [
				{
					"name": "Active Campaign with UTM params — 302 Redirect",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('status is 302', function () { pm.response.to.have.status(302); });",
									"pm.test('Location header equals destination_url', function () {",
									"    var location = pm.response.headers.get('Location');",
									"    pm.expect(location).to.eql(pm.environment.get('kan15_offer_destination_url'));",
									"});",
									"pm.test('no authentication required', function () {",
									"    pm.response.to.not.have.header('Authorization');",
									"});"
								]
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [
							{ "key": "Accept", "value": "text/html" }
						],
						"url": {
							"raw": "{{base_url}}/t/{{kan15_active_tracking_code}}?utm_source=facebook&utm_medium=cpc&utm_campaign=kan15_test&utm_term=keyword&utm_content=banner",
							"host": ["{{base_url}}"],
							"path": ["t", "{{kan15_active_tracking_code}}"],
							"query": [
								{ "key": "utm_source", "value": "facebook" },
								{ "key": "utm_medium", "value": "cpc" },
								{ "key": "utm_campaign", "value": "kan15_test" },
								{ "key": "utm_term", "value": "keyword" },
								{ "key": "utm_content", "value": "banner" }
							]
						}
					},
					"response": []
				}
			]
		},
