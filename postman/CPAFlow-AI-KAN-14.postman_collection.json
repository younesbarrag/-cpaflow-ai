		{
			"name": "01 — Generate Tracking Link",
			"item": [
				{
					"name": "Generate Tracking Link (Owner, Active Campaign)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('status is 201', function () { pm.response.to.have.status(201); });",
									"pm.test('Content-Type is JSON', function () { pm.response.to.be.json; });",
									"pm.test('response has data.tracking_link', function () { pm.expect(pm.response.json().data).to.have.property('tracking_link'); });",
									"",
									"var body = pm.response.json();",
									"var tl = body.data.tracking_link;",
									"",
									"pm.test('tracking_link has exactly: id, campaign_id, code, url, created_at, updated_at', function () {",
									"    pm.expect(Object.keys(tl)).to.eql(['id', 'campaign_id', 'code', 'url', 'created_at', 'updated_at']);",
									"});",
									"",
									"pm.test('campaign_id matches active_campaign_id', function () {",
									"    pm.expect(tl.campaign_id).to.eql(Number(pm.environment.get('active_campaign_id')));",
									"});",
									"",
									"pm.test('code is a string', function () { pm.expect(tl.code).to.be.a('string'); });",
									"pm.test('code is exactly 32 characters', function () { pm.expect(tl.code).to.have.length(32); });",
									"pm.test('code matches /^[A-Za-z0-9]{32}$/', function () { pm.expect(tl.code).to.match(/^[A-Za-z0-9]{32}$/); });",
									"",
									"pm.test('url equals normalized base_url + /t/ + code', function () {",
									"    var base = pm.environment.get('base_url').replace(/\\/$/, '');",
									"    pm.expect(tl.url).to.eql(base + '/t/' + tl.code);",
									"});",
									"",
									"pm.test('created_at exists', function () { pm.expect(tl.created_at).to.exist; });",
									"pm.test('updated_at exists', function () { pm.expect(tl.updated_at).to.exist; });",
									"",
									"pm.test('response does not expose user_id', function () { pm.expect(tl).to.not.have.property('user_id'); });",
									"pm.test('response does not expose offer_id', function () { pm.expect(tl).to.not.have.property('offer_id'); });",
									"pm.test('response does not expose destination_url', function () { pm.expect(tl).to.not.have.property('destination_url'); });",
									"pm.test('response does not expose is_active', function () { pm.expect(tl).to.not.have.property('is_active'); });",
									"pm.test('response does not expose campaign', function () { pm.expect(tl).to.not.have.property('campaign'); });",
									"pm.test('response does not expose offer', function () { pm.expect(tl).to.not.have.property('offer'); });",
									"pm.test('response does not expose name', function () { pm.expect(tl).to.not.have.property('name'); });",
									"pm.test('response does not expose budget', function () { pm.expect(tl).to.not.have.property('budget'); });",
