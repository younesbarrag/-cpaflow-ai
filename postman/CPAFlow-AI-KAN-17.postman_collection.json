		{
			"name": "01 — Create Expense",
			"item": [
				{
					"name": "Record Expense (201 Created)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('status is 201', function () { pm.response.to.have.status(201); });",
									"pm.test('Content-Type is JSON', function () { pm.response.to.be.json; });",
									"",
									"var body = pm.response.json();",
									"pm.test('has data.campaign_expense envelope', function () {",
									"    pm.expect(body).to.have.property('data');",
									"    pm.expect(body.data).to.have.property('campaign_expense');",
									"});",
									"",
									"var exp = body.data.campaign_expense;",
									"pm.test('expense has required fields', function () {",
									"    pm.expect(exp).to.have.all.keys('id', 'campaign_id', 'amount', 'spent_at', 'description', 'created_at', 'updated_at');",
									"});",
									"",
									"pm.test('campaign_id matches', function () { pm.expect(String(exp.campaign_id)).to.eql(pm.environment.get('kan17_campaign_id')); });",
									"pm.test('amount is 75.25', function () { pm.expect(exp.amount).to.eql('75.25'); });",
									"pm.test('description matches', function () { pm.expect(exp.description).to.eql('Google Ads spend'); });",
									"",
									"if (exp.id) {",
									"    pm.environment.set('kan17_expense_id', String(exp.id));",
									"}"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" },
							{ "key": "Accept", "value": "application/json" },
							{ "key": "Authorization", "value": "Bearer {{kan17_owner_token}}", "type": "text" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"amount\": \"75.25\",\n  \"spent_at\": \"2026-07-15\",\n  \"description\": \"Google Ads spend\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/v1/campaigns/{{kan17_campaign_id}}/expenses",
							"host": ["{{base_url}}"],
							"path": ["api", "v1", "campaigns", "{{kan17_campaign_id}}", "expenses"]
						}
					},
					"response": []
				}
			]
		},
