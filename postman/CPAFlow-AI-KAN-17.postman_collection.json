									"",
									"var body = pm.response.json();",
									"pm.test('response has data array', function () {",
									"    pm.expect(body).to.have.property('data');",
									"    pm.expect(body.data).to.be.an('array');",
									"    pm.expect(body.data.length).to.be.above(0);",
									"});",
									"",
									"pm.test('first expense has correct fields', function () {",
									"    var first = body.data[0];",
									"    pm.expect(first).to.have.all.keys('id', 'campaign_id', 'amount', 'spent_at', 'description', 'created_at', 'updated_at');",
									"});",
									"",
									"pm.test('has meta pagination', function () {",
									"    pm.expect(body).to.have.property('meta');",
									"    pm.expect(body.meta).to.have.property('total');",
									"    pm.expect(body.meta).to.have.property('per_page');",
									"});"
								]
							}
						}
					],
