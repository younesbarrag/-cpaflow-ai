						"header": [
							{ "key": "Accept", "value": "application/json" },
							{ "key": "Authorization", "value": "Bearer {{cr_token}}" }
						],
						"url": {
							"raw": "{{base_url}}/api/v1/campaigns/{{cr_campaign_id}}/conversions/{{cr_conversion_b_id}}/approve",
							"host": ["{{base_url}}"],
							"path": ["api", "v1", "campaigns", "{{cr_campaign_id}}", "conversions", "{{cr_conversion_b_id}}", "approve"]
						}
					},
					"response": []
				}
			]
