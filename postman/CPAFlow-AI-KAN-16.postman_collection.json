{
	"info": {
		"_postman_id": "cpaflow-ai-kan16-collection",
		"name": "CPAFlow AI — KAN-16 Record Conversion Without Duplicate",
		"description": "End-to-end Postman verification for KAN-16: Record conversion without duplicate.\n\nTests the authenticated POST /api/v1/campaigns/{campaign}/conversions endpoint with valid conversion, duplicate prevention, validation, authorization, and response shape.\nUses real HTTP requests against the local CPAFlow API.\nRun with: npx newman run <collection> -e <env>",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [],
	"item": [
		{
			"name": "00 — Setup",
			"item": [
				{
					"name": "Health Check",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('status is 200', function () { pm.response.to.have.status(200); });",
									"pm.test('Content-Type is JSON', function () { pm.response.to.be.json; });"
								]
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [
							{ "key": "Accept", "value": "application/json" }
						],
						"url": {
							"raw": "{{base_url}}/api/v1/health",
							"host": ["{{base_url}}"],
							"path": ["api", "v1", "health"]
						}
					},
					"response": []
				},
				{
					"name": "Generate Owner Credentials",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var ts = Date.now();",
									"var email = 'kan16-owner-' + ts + '@example.com';",
									"var password = 'PostmanPass123!';",
									"pm.environment.set('kan16_owner_email', email);",
									"pm.environment.set('kan16_owner_password', password);",
									"console.log('KAN-16 Owner email: ' + email);"
								]
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [
							{ "key": "Accept", "value": "application/json" }
						],
						"url": {
							"raw": "{{base_url}}/api/v1/health",
							"host": ["{{base_url}}"],
							"path": ["api", "v1", "health"]
						}
					},
					"response": []
				},
				{
					"name": "Register Owner",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('status is 201', function () { pm.response.to.have.status(201); });",
									"pm.test('Content-Type is JSON', function () { pm.response.to.be.json; });"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" },
							{ "key": "Accept", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"KAN-16 Postman Test Owner\",\n  \"email\": \"{{kan16_owner_email}}\",\n  \"password\": \"{{kan16_owner_password}}\",\n  \"password_confirmation\": \"{{kan16_owner_password}}\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/v1/auth/register",
							"host": ["{{base_url}}"],
							"path": ["api", "v1", "auth", "register"]
						}
					},
					"response": []
				},
				{
					"name": "Login Owner",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('status is 200', function () { pm.response.to.have.status(200); });",
									"pm.test('Content-Type is JSON', function () { pm.response.to.be.json; });",
									"pm.test('response has token', function () { pm.expect(pm.response.json()).to.have.property('token'); });",
									"",
									"var body = pm.response.json();",
									"if (body.token) {",
									"    pm.environment.set('kan16_owner_token', body.token);",
									"}"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" },
							{ "key": "Accept", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"{{kan16_owner_email}}\",\n  \"password\": \"{{kan16_owner_password}}\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/v1/auth/login",
							"host": ["{{base_url}}"],
							"path": ["api", "v1", "auth", "login"]
						}
					},
					"response": []
				},
				{
					"name": "Create Offer",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('status is 201', function () { pm.response.to.have.status(201); });",
									"pm.test('Content-Type is JSON', function () { pm.response.to.be.json; });",
									"",
									"var body = pm.response.json();",
									"if (body.data && body.data.offer) {",
									"    pm.environment.set('kan16_offer_id', String(body.data.offer.id));",
									"    pm.environment.set('kan16_offer_payout', body.data.offer.payout);",
									"}"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" },
							{ "key": "Accept", "value": "application/json" },
							{ "key": "Authorization", "value": "Bearer {{kan16_owner_token}}", "type": "text" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"KAN-16 Postman Test Offer\",\n  \"destination_url\": \"https://example.com/kan16-offer\",\n  \"payout\": 12.50,\n  \"status\": \"active\",\n  \"description\": \"KAN-16 Postman Test Offer Description\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/v1/offers",
							"host": ["{{base_url}}"],
							"path": ["api", "v1", "offers"]
						}
					},
					"response": []
				},
				{
					"name": "Create Campaign",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('status is 201', function () { pm.response.to.have.status(201); });",
									"",
									"var body = pm.response.json();",
									"if (body.data && body.data.campaign) {",
									"    pm.environment.set('kan16_campaign_id', String(body.data.campaign.id));",
									"}"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" },
							{ "key": "Accept", "value": "application/json" },
							{ "key": "Authorization", "value": "Bearer {{kan16_owner_token}}", "type": "text" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"offer_id\": {{kan16_offer_id}},\n  \"name\": \"KAN-16 Postman Test Campaign\",\n  \"traffic_source\": \"Facebook\",\n  \"budget\": 500.00\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/v1/campaigns",
							"host": ["{{base_url}}"],
							"path": ["api", "v1", "campaigns"]
						}
					},
					"response": []
				}
			]
		},
		{
			"name": "01 — Record Conversion",
			"item": [
				{
					"name": "Record First Conversion (201 Created)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('status is 201', function () { pm.response.to.have.status(201); });",
									"pm.test('Content-Type is JSON', function () { pm.response.to.be.json; });",
									"",
									"var body = pm.response.json();",
									"pm.test('has data.conversion envelope', function () {",
									"    pm.expect(body).to.have.property('data');",
									"    pm.expect(body.data).to.have.property('conversion');",
									"});",
									"",
									"var conv = body.data.conversion;",
									"pm.test('conversion has required fields', function () {",
									"    pm.expect(conv).to.have.all.keys('id', 'campaign_id', 'external_id', 'source', 'revenue', 'status', 'converted_at', 'created_at', 'updated_at');",
									"});",
									"",
									"pm.test('external_id matches', function () { pm.expect(conv.external_id).to.eql('TXN-POSTMAN-001'); });",
									"pm.test('status is pending', function () { pm.expect(conv.status).to.eql('pending'); });",
									"pm.test('revenue matches offer payout', function () { pm.expect(conv.revenue).to.eql('12.50'); });",
									"pm.test('campaign_id matches', function () { pm.expect(String(conv.campaign_id)).to.eql(pm.environment.get('kan16_campaign_id')); });",
									"",
									"if (conv.id) {",
									"    pm.environment.set('kan16_conversion_id', String(conv.id));",
									"}"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" },
							{ "key": "Accept", "value": "application/json" },
							{ "key": "Authorization", "value": "Bearer {{kan16_owner_token}}", "type": "text" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"external_id\": \"TXN-POSTMAN-001\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/v1/campaigns/{{kan16_campaign_id}}/conversions",
							"host": ["{{base_url}}"],
							"path": ["api", "v1", "campaigns", "{{kan16_campaign_id}}", "conversions"]
						}
					},
					"response": []
				}
			]
		},
		{
			"name": "02 — Duplicate Prevention",
			"item": [
				{
					"name": "Duplicate External ID Returns 409",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('status is 409', function () { pm.response.to.have.status(409); });",
									"pm.test('Content-Type is JSON', function () { pm.response.to.be.json; });",
									"",
									"var body = pm.response.json();",
									"pm.test('has error message', function () {",
									"    pm.expect(body).to.have.property('message');",
									"    pm.expect(body.message).to.include('already exists');",
									"});",
									"pm.test('has errors.external_id', function () {",
									"    pm.expect(body).to.have.property('errors');",
									"    pm.expect(body.errors).to.have.property('external_id');",
									"});"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" },
							{ "key": "Accept", "value": "application/json" },
							{ "key": "Authorization", "value": "Bearer {{kan16_owner_token}}", "type": "text" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"external_id\": \"TXN-POSTMAN-001\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/v1/campaigns/{{kan16_campaign_id}}/conversions",
							"host": ["{{base_url}}"],
							"path": ["api", "v1", "campaigns", "{{kan16_campaign_id}}", "conversions"]
						}
					},
					"response": []
				}
			]
		},
		{
			"name": "03 — Different Conversion Succeeds",
			"item": [
				{
					"name": "Record Different Conversion (201 Created)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('status is 201', function () { pm.response.to.have.status(201); });",
									"",
									"var body = pm.response.json();",
									"var conv = body.data.conversion;",
									"",
									"pm.test('new external_id', function () { pm.expect(conv.external_id).to.eql('TXN-POSTMAN-002'); });",
									"pm.test('status is pending', function () { pm.expect(conv.status).to.eql('pending'); });",
									"pm.test('revenue matches offer payout', function () { pm.expect(conv.revenue).to.eql('12.50'); });"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" },
							{ "key": "Accept", "value": "application/json" },
							{ "key": "Authorization", "value": "Bearer {{kan16_owner_token}}", "type": "text" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"external_id\": \"TXN-POSTMAN-002\",\n  \"source\": \"tiktok\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/v1/campaigns/{{kan16_campaign_id}}/conversions",
							"host": ["{{base_url}}"],
							"path": ["api", "v1", "campaigns", "{{kan16_campaign_id}}", "conversions"]
						}
					},
					"response": []
				}
			]
		},
		{
			"name": "04 — Validation Errors",
			"item": [
				{
					"name": "Missing External ID Returns 422",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('status is 422', function () { pm.response.to.have.status(422); });",
									"",
									"var body = pm.response.json();",
									"pm.test('has errors.external_id', function () {",
									"    pm.expect(body).to.have.property('errors');",
									"    pm.expect(body.errors).to.have.property('external_id');",
									"});"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" },
							{ "key": "Accept", "value": "application/json" },
							{ "key": "Authorization", "value": "Bearer {{kan16_owner_token}}", "type": "text" }
						],
						"body": {
							"mode": "raw",
							"raw": "{}"
						},
						"url": {
							"raw": "{{base_url}}/api/v1/campaigns/{{kan16_campaign_id}}/conversions",
							"host": ["{{base_url}}"],
							"path": ["api", "v1", "campaigns", "{{kan16_campaign_id}}", "conversions"]
						}
					},
					"response": []
				}
			]
		},
		{
			"name": "05 — Authorization",
			"item": [
				{
					"name": "Guest Returns 401",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('status is 401', function () { pm.response.to.have.status(401); });"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" },
							{ "key": "Accept", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"external_id\": \"TXN-GUEST\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/v1/campaigns/{{kan16_campaign_id}}/conversions",
							"host": ["{{base_url}}"],
							"path": ["api", "v1", "campaigns", "{{kan16_campaign_id}}", "conversions"]
						}
					},
					"response": []
				},
				{
					"name": "Unknown Campaign Returns 404",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('status is 404', function () { pm.response.to.have.status(404); });"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" },
							{ "key": "Accept", "value": "application/json" },
							{ "key": "Authorization", "value": "Bearer {{kan16_owner_token}}", "type": "text" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"external_id\": \"TXN-UNKNOWN\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/v1/campaigns/999999/conversions",
							"host": ["{{base_url}}"],
							"path": ["api", "v1", "campaigns", "999999", "conversions"]
						}
					},
					"response": []
				}
			]
		}
	]
}
