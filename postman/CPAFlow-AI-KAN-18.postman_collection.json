{
	"info": {
		"_postman_id": "cpaflow-ai-kan18-collection",
		"name": "CPAFlow AI — KAN-18 Dashboard Statistics",
		"description": "End-to-end Postman verification for KAN-18: Dashboard statistics.\n\nTests the authenticated dashboard statistics endpoint: empty state, data state.\nCovers authorization, response shape, and metric correctness.\nUses real HTTP requests against the local CPAFlow API.\nRun with: npx newman run <collection> -e <env>",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [],
	"item": [
		{
			"name": "00 — Setup",
			"item": [
				{
					"name": "Health Check",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('status is 200', function () { pm.response.to.have.status(200); });",
									"pm.test('Content-Type is JSON', function () { pm.response.to.be.json; });"
								]
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [
							{ "key": "Accept", "value": "application/json" }
						],
						"url": {
							"raw": "{{base_url}}/api/v1/health",
							"host": ["{{base_url}}"],
							"path": ["api", "v1", "health"]
						}
					},
					"response": []
				},
				{
					"name": "Generate Owner Credentials",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var ts = Date.now();",
									"var email = 'kan18-owner-' + ts + '@example.com';",
									"var password = 'PostmanPass123!';",
									"pm.environment.set('kan18_owner_email', email);",
									"pm.environment.set('kan18_owner_password', password);",
									"console.log('KAN-18 Owner email: ' + email);"
								]
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [
							{ "key": "Accept", "value": "application/json" }
						],
						"url": {
							"raw": "{{base_url}}/api/v1/health",
							"host": ["{{base_url}}"],
							"path": ["api", "v1", "health"]
						}
					},
					"response": []
				},
				{
					"name": "Register Owner",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('status is 201', function () { pm.response.to.have.status(201); });",
									"pm.test('Content-Type is JSON', function () { pm.response.to.be.json; });"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" },
							{ "key": "Accept", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"KAN-18 Postman Test Owner\",\n  \"email\": \"{{kan18_owner_email}}\",\n  \"password\": \"{{kan18_owner_password}}\",\n  \"password_confirmation\": \"{{kan18_owner_password}}\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/v1/auth/register",
							"host": ["{{base_url}}"],
							"path": ["api", "v1", "auth", "register"]
						}
					},
					"response": []
				},
				{
					"name": "Login Owner",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('status is 200', function () { pm.response.to.have.status(200); });",
									"pm.test('Content-Type is JSON', function () { pm.response.to.be.json; });",
									"var res = pm.response.json();",
									"if (res.token) { pm.environment.set('kan18_owner_token', res.token); }"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" },
							{ "key": "Accept", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"{{kan18_owner_email}}\",\n  \"password\": \"{{kan18_owner_password}}\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/v1/auth/login",
							"host": ["{{base_url}}"],
							"path": ["api", "v1", "auth", "login"]
						}
					},
					"response": []
				}
			]
		},
		{
			"name": "01 — Dashboard Statistics (Empty)",
			"item": [
				{
					"name": "Request Statistics — Empty User (200 OK)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('status is 200', function () { pm.response.to.have.status(200); });",
									"pm.test('Content-Type is JSON', function () { pm.response.to.be.json; });",
									"var res = pm.response.json();",
									"pm.test('has data.statistics envelope', function () {",
									"    pm.expect(res.data).to.have.property('statistics');",
									"});",
									"var s = res.data.statistics;",
									"pm.test('offer_count is 0', function () { pm.expect(s.offer_count).to.equal(0); });",
									"pm.test('campaign_count is 0', function () { pm.expect(s.campaign_count).to.equal(0); });",
									"pm.test('active_campaign_count is 0', function () { pm.expect(s.active_campaign_count).to.equal(0); });",
									"pm.test('click_count is 0', function () { pm.expect(s.click_count).to.equal(0); });",
									"pm.test('conversion_count is 0', function () { pm.expect(s.conversion_count).to.equal(0); });",
									"pm.test('revenue is 0.00', function () { pm.expect(s.revenue).to.equal('0.00'); });",
									"pm.test('total_expenses is 0.00', function () { pm.expect(s.total_expenses).to.equal('0.00'); });",
									"pm.test('profit is 0.00', function () { pm.expect(s.profit).to.equal('0.00'); });"
								]
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [
							{ "key": "Accept", "value": "application/json" },
							{ "key": "Authorization", "value": "Bearer {{kan18_owner_token}}", "type": "text" }
						],
						"url": {
							"raw": "{{base_url}}/api/v1/dashboard/statistics",
							"host": ["{{base_url}}"],
							"path": ["api", "v1", "dashboard", "statistics"]
						}
					},
					"response": []
				}
			]
		},
		{
			"name": "02 — Create Test Data",
			"item": [
				{
					"name": "Create Offer (201 Created)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('status is 201', function () { pm.response.to.have.status(201); });",
									"var res = pm.response.json();",
									"if (res.data && res.data.offer) { pm.environment.set('kan18_offer_id', String(res.data.offer.id)); }"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" },
							{ "key": "Accept", "value": "application/json" },
							{ "key": "Authorization", "value": "Bearer {{kan18_owner_token}}", "type": "text" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"KAN-18 Test Offer\",\n  \"destination_url\": \"https://example.com/offer\",\n  \"payout\": \"25.00\",\n  \"status\": \"active\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/v1/offers",
							"host": ["{{base_url}}"],
							"path": ["api", "v1", "offers"]
						}
					},
					"response": []
				},
				{
					"name": "Create Campaign (201 Created)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('status is 201', function () { pm.response.to.have.status(201); });",
									"var res = pm.response.json();",
									"if (res.data && res.data.campaign) { pm.environment.set('kan18_campaign_id', String(res.data.campaign.id)); }"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" },
							{ "key": "Accept", "value": "application/json" },
							{ "key": "Authorization", "value": "Bearer {{kan18_owner_token}}", "type": "text" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"KAN-18 Test Campaign\",\n  \"offer_id\": {{kan18_offer_id}},\n  \"traffic_source\": \"test\",\n  \"budget\": \"500.00\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/v1/campaigns",
							"host": ["{{base_url}}"],
							"path": ["api", "v1", "campaigns"]
						}
					},
					"response": []
				},
				{
					"name": "Activate Campaign (200 OK)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('status is 200', function () { pm.response.to.have.status(200); });"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Accept", "value": "application/json" },
							{ "key": "Authorization", "value": "Bearer {{kan18_owner_token}}", "type": "text" }
						],
						"url": {
							"raw": "{{base_url}}/api/v1/campaigns/{{kan18_campaign_id}}/activate",
							"host": ["{{base_url}}"],
							"path": ["api", "v1", "campaigns", "{{kan18_campaign_id}}", "activate"]
						}
					},
					"response": []
				},
				{
					"name": "Create Pending Conversion (201 Created)",
					"event": [
						{
							"listen": "prerequest",
							"script": {
								"exec": [
									"var extId = 'ext-kan18-' + Date.now();",
									"pm.environment.set('kan18_ext_id', extId);"
								]
							}
						},
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('status is 201', function () { pm.response.to.have.status(201); });",
									"var res = pm.response.json();",
									"if (res.data && res.data.conversion) { pm.environment.set('kan18_conversion_id', String(res.data.conversion.id)); }"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" },
							{ "key": "Accept", "value": "application/json" },
							{ "key": "Authorization", "value": "Bearer {{kan18_owner_token}}", "type": "text" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"external_id\": \"{{kan18_ext_id}}\",\n  \"source\": \"postman\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/v1/campaigns/{{kan18_campaign_id}}/conversions",
							"host": ["{{base_url}}"],
							"path": ["api", "v1", "campaigns", "{{kan18_campaign_id}}", "conversions"]
						}
					},
					"response": []
				},
				{
					"name": "Create Campaign Expense (201 Created)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('status is 201', function () { pm.response.to.have.status(201); });",
									"var res = pm.response.json();",
									"if (res.data && res.data.campaign_expense) { pm.environment.set('kan18_expense_id', String(res.data.campaign_expense.id)); }"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" },
							{ "key": "Accept", "value": "application/json" },
							{ "key": "Authorization", "value": "Bearer {{kan18_owner_token}}", "type": "text" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"amount\": \"35.50\",\n  \"spent_at\": \"2026-08-01\",\n  \"description\": \"KAN-18 test expense\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/v1/campaigns/{{kan18_campaign_id}}/expenses",
							"host": ["{{base_url}}"],
							"path": ["api", "v1", "campaigns", "{{kan18_campaign_id}}", "expenses"]
						}
					},
					"response": []
				}
			]
		},
		{
			"name": "03 — Dashboard Statistics (With Data)",
			"item": [
				{
					"name": "Request Statistics — With Data (200 OK)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('status is 200', function () { pm.response.to.have.status(200); });",
									"pm.test('Content-Type is JSON', function () { pm.response.to.be.json; });",
									"var res = pm.response.json();",
									"pm.test('has data.statistics envelope', function () {",
									"    pm.expect(res.data).to.have.property('statistics');",
									"});",
									"var s = res.data.statistics;",
									"pm.test('offer_count is 1', function () { pm.expect(s.offer_count).to.equal(1); });",
									"pm.test('campaign_count is 1', function () { pm.expect(s.campaign_count).to.equal(1); });",
									"pm.test('active_campaign_count is 1', function () { pm.expect(s.active_campaign_count).to.equal(1); });",
									"pm.test('conversion_count is 1', function () { pm.expect(s.conversion_count).to.equal(1); });",
									"pm.test('revenue is 0.00 (pending conversion)', function () { pm.expect(s.revenue).to.equal('0.00'); });",
									"pm.test('total_expenses is 35.50', function () { pm.expect(s.total_expenses).to.equal('35.50'); });",
									"pm.test('profit is negative (pending rev + expenses)', function () { pm.expect(parseFloat(s.profit)).to.be.below(0); });"
								]
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [
							{ "key": "Accept", "value": "application/json" },
							{ "key": "Authorization", "value": "Bearer {{kan18_owner_token}}", "type": "text" }
						],
						"url": {
							"raw": "{{base_url}}/api/v1/dashboard/statistics",
							"host": ["{{base_url}}"],
							"path": ["api", "v1", "dashboard", "statistics"]
						}
					},
					"response": []
				}
			]
		},
		{
			"name": "04 — Authorization",
			"item": [
				{
					"name": "Guest Request — 401 Unauthorized",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('status is 401', function () { pm.response.to.have.status(401); });"
								]
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [
							{ "key": "Accept", "value": "application/json" }
						],
						"url": {
							"raw": "{{base_url}}/api/v1/dashboard/statistics",
							"host": ["{{base_url}}"],
							"path": ["api", "v1", "dashboard", "statistics"]
						}
					},
					"response": []
				}
			]
		}
	]
}
