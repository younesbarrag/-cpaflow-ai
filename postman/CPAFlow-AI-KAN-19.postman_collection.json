		{
			"name": "03 — Period Filtering",
			"item": [
				{
					"name": "All-Time Statistics (200 OK)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('status is 200', function () { pm.response.to.have.status(200); });",
									"var res = pm.response.json();",
									"var s = res.data.statistics;",
									"pm.test('offer_count is 1', function () { pm.expect(s.offer_count).to.equal(1); });",
									"pm.test('campaign_count is 1', function () { pm.expect(s.campaign_count).to.equal(1); });",
									"pm.test('active_campaign_count is 1', function () { pm.expect(s.active_campaign_count).to.equal(1); });",
									"pm.test('conversion_count is 1', function () { pm.expect(s.conversion_count).to.equal(1); });",
									"pm.test('revenue is 0.00 (pending)', function () { pm.expect(s.revenue).to.equal('0.00'); });",
									"pm.test('total_expenses is 35.50', function () { pm.expect(s.total_expenses).to.equal('35.50'); });"
								]
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [
