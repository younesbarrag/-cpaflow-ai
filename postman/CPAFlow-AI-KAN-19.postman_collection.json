		{
			"name": "01 — Empty All-Time Statistics",
			"item": [
				{
					"name": "Request Statistics — Empty User (200 OK)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('status is 200', function () { pm.response.to.have.status(200); });",
									"var res = pm.response.json();",
									"pm.test('has data.statistics envelope', function () { pm.expect(res.data).to.have.property('statistics'); });",
									"var s = res.data.statistics;",
									"pm.test('offer_count is 0', function () { pm.expect(s.offer_count).to.equal(0); });",
									"pm.test('click_count is 0', function () { pm.expect(s.click_count).to.equal(0); });",
									"pm.test('revenue is 0.00', function () { pm.expect(s.revenue).to.equal('0.00'); });"
								]
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [
							{ "key": "Accept", "value": "application/json" },
							{ "key": "Authorization", "value": "Bearer {{kan19_owner_token}}", "type": "text" }
						],
						"url": {
							"raw": "{{base_url}}/api/v1/dashboard/statistics",
							"host": ["{{base_url}}"],
							"path": ["api", "v1", "dashboard", "statistics"]
						}
					},
					"response": []
				}
			]
		},
