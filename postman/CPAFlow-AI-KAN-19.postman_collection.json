							"mode": "raw",
							"raw": "{\n  \"name\": \"KAN-19 Postman Test Owner\",\n  \"email\": \"{{kan19_owner_email}}\",\n  \"password\": \"{{kan19_owner_password}}\",\n  \"password_confirmation\": \"{{kan19_owner_password}}\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/v1/auth/register",
							"host": ["{{base_url}}"],
							"path": ["api", "v1", "auth", "register"]
						}
					},
					"response": []
				},
				{
					"name": "Login Owner",
