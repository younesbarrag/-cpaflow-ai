{
	"info": {
		"_postman_id": "cpaflow-ai-kan19-collection",
		"name": "CPAFlow AI — KAN-19 Statistics Period Filters",
		"description": "End-to-end Postman verification for KAN-19: Statistics period filters.\n\nTests the authenticated dashboard statistics endpoint with period filtering.\nCovers predefined periods, custom ranges, validation errors, and authorization.\nUses real HTTP requests against the local CPAFlow API.\nRun with: npx newman run <collection> -e <env>",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [],
	"item": [
		{
			"name": "00 — Setup",
			"item": [
				{
					"name": "Health Check",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('status is 200', function () { pm.response.to.have.status(200); });",
									"pm.test('Content-Type is JSON', function () { pm.response.to.be.json; });"
								]
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [
							{ "key": "Accept", "value": "application/json" }
						],
						"url": {
							"raw": "{{base_url}}/api/v1/health",
							"host": ["{{base_url}}"],
							"path": ["api", "v1", "health"]
						}
					},
					"response": []
				},
				{
					"name": "Generate Owner Credentials",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var ts = Date.now();",
									"var email = 'kan19-owner-' + ts + '@example.com';",
									"var password = 'PostmanPass123!';",
									"pm.environment.set('kan19_owner_email', email);",
									"pm.environment.set('kan19_owner_password', password);",
									"var today = new Date().toISOString().slice(0, 10);",
									"pm.environment.set('kan19_today', today);",
									"console.log('KAN-19 Owner email: ' + email);"
								]
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [
							{ "key": "Accept", "value": "application/json" }
						],
						"url": {
							"raw": "{{base_url}}/api/v1/health",
							"host": ["{{base_url}}"],
							"path": ["api", "v1", "health"]
						}
					},
					"response": []
				},
				{
					"name": "Register Owner",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('status is 201', function () { pm.response.to.have.status(201); });",
									"pm.test('Content-Type is JSON', function () { pm.response.to.be.json; });"
								]
							}
						}
