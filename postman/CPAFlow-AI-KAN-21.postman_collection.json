{
	"info": {
		"_postman_id": "cpaflow-ai-kan21-collection",
		"name": "CPAFlow AI — KAN-21 AI Content Generation",
		"description": "End-to-end Postman verification for KAN-21: AI Marketing Content Generation.\n\nTests the content generation endpoints (trigger + list + show) with Prism structured output.\nCovers happy path, prerequisite validation, authorization, and error handling.\nUses real HTTP requests against the local CPAFlow API.\nRun with: npx newman run <collection> -e <env>",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [],
	"item": [
		{
			"name": "00 — Setup",
			"item": [
				{
					"name": "Health Check",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('status is 200', function () { pm.response.to.have.status(200); });",
									"pm.test('Content-Type is JSON', function () { pm.response.to.be.json; });"
								]
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [
							{ "key": "Accept", "value": "application/json" }
						],
						"url": {
							"raw": "{{base_url}}/api/v1/health",
							"host": ["{{base_url}}"],
							"path": ["api", "v1", "health"]
						}
					},
					"response": []
				},
				{
					"name": "Generate Owner Credentials",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var ts = Date.now();",
									"var email = 'kan21-owner-' + ts + '@example.com';",
									"var password = 'PostmanPass123!';",
									"pm.environment.set('kan21_owner_email', email);",
									"pm.environment.set('kan21_owner_password', password);",
									"console.log('KAN-21 Owner email: ' + email);"
								]
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [
							{ "key": "Accept", "value": "application/json" }
						],
						"url": {
							"raw": "{{base_url}}/api/v1/health",
							"host": ["{{base_url}}"],
							"path": ["api", "v1", "health"]
						}
					},
					"response": []
				},
				{
					"name": "Register Owner",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('status is 201', function () { pm.response.to.have.status(201); });",
									"pm.test('Content-Type is JSON', function () { pm.response.to.be.json; });"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" },
							{ "key": "Accept", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"KAN-21 Owner\",\n  \"email\": \"{{kan21_owner_email}}\",\n  \"password\": \"{{kan21_owner_password}}\",\n  \"password_confirmation\": \"{{kan21_owner_password}}\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/v1/auth/register",
							"host": ["{{base_url}}"],
							"path": ["api", "v1", "auth", "register"]
						}
					},
					"response": []
				},
				{
					"name": "Login Owner",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('status is 200', function () { pm.response.to.have.status(200); });",
									"var res = pm.response.json();",
									"pm.environment.set('kan21_owner_token', res.token);",
									"console.log('KAN-21 Owner token acquired');"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" },
							{ "key": "Accept", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"{{kan21_owner_email}}\",\n  \"password\": \"{{kan21_owner_password}}\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/v1/auth/login",
							"host": ["{{base_url}}"],
							"path": ["api", "v1", "auth", "login"]
						}
					},
					"response": []
				},
				{
					"name": "Create Offer",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('status is 201', function () { pm.response.to.have.status(201); });",
									"var res = pm.response.json();",
									"pm.environment.set('kan21_offer_id', res.data.offer.id);",
									"console.log('KAN-21 Offer ID: ' + res.data.offer.id);"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" },
							{ "key": "Accept", "value": "application/json" },
							{ "key": "Authorization", "value": "Bearer {{kan21_owner_token}}" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"KAN-21 Test Offer\",\n  \"description\": \"A CPA offer for testing content generation\",\n  \"payout\": 25.00,\n  \"destination_url\": \"https://example.com/offer\",\n  \"status\": \"draft\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/v1/offers",
							"host": ["{{base_url}}"],
							"path": ["api", "v1", "offers"]
						}
					},
					"response": []
				}
			]
		},
		{
			"name": "01 — Prerequisite Validation",
			"item": [
				{
					"name": "Trigger without analysis returns 422",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('status is 422', function () { pm.response.to.have.status(422); });",
									"var res = pm.response.json();",
									"pm.test('message mentions analysis', function () { pm.expect(res.message).to.contain('analyse'); });"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Accept", "value": "application/json" },
							{ "key": "Authorization", "value": "Bearer {{kan21_owner_token}}" }
						],
						"url": {
							"raw": "{{base_url}}/api/v1/offers/{{kan21_offer_id}}/generate",
							"host": ["{{base_url}}"],
							"path": ["api", "v1", "offers", "{{kan21_offer_id}}", "generate"]
						}
					},
					"response": []
				}
			]
		},
		{
			"name": "02 — Authorization",
			"item": [
				{
					"name": "Guest trigger returns 401",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('status is 401', function () { pm.response.to.have.status(401); });"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Accept", "value": "application/json" }
						],
						"url": {
							"raw": "{{base_url}}/api/v1/offers/{{kan21_offer_id}}/generate",
							"host": ["{{base_url}}"],
							"path": ["api", "v1", "offers", "{{kan21_offer_id}}", "generate"]
						}
					},
					"response": []
				},
				{
					"name": "Guest index returns 401",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('status is 401', function () { pm.response.to.have.status(401); });"
								]
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [
							{ "key": "Accept", "value": "application/json" }
						],
						"url": {
							"raw": "{{base_url}}/api/v1/offers/{{kan21_offer_id}}/generations",
							"host": ["{{base_url}}"],
							"path": ["api", "v1", "offers", "{{kan21_offer_id}}", "generations"]
						}
					},
					"response": []
				},
				{
					"name": "Unknown offer returns 404",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('status is 404', function () { pm.response.to.have.status(404); });"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Accept", "value": "application/json" },
							{ "key": "Authorization", "value": "Bearer {{kan21_owner_token}}" }
						],
						"url": {
							"raw": "{{base_url}}/api/v1/offers/99999/generate",
							"host": ["{{base_url}}"],
							"path": ["api", "v1", "offers", "99999", "generate"]
						}
					},
					"response": []
				}
			]
		},
		{
			"name": "03 — Listing",
			"item": [
				{
					"name": "Get generations returns empty list",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('status is 200', function () { pm.response.to.have.status(200); });",
									"var res = pm.response.json();",
									"pm.test('data is array', function () { pm.expect(res.data).to.be.an('array'); });"
								]
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [
							{ "key": "Accept", "value": "application/json" },
							{ "key": "Authorization", "value": "Bearer {{kan21_owner_token}}" }
						],
						"url": {
							"raw": "{{base_url}}/api/v1/offers/{{kan21_offer_id}}/generations",
							"host": ["{{base_url}}"],
							"path": ["api", "v1", "offers", "{{kan21_offer_id}}", "generations"]
						}
					},
					"response": []
				}
			]
		}
	]
}
