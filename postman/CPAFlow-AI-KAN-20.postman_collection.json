{
	"info": {
		"_postman_id": "cpaflow-ai-kan20-collection",
		"name": "CPAFlow AI — KAN-20 AI Offer Analysis",
		"description": "End-to-end Postman verification for KAN-20: AI Offer Analysis.\n\nTests the offer analysis endpoint (trigger + retrieve) with Prism structured output.\nCovers happy path, stale detection, authorization, and error handling.\nUses real HTTP requests against the local CPAFlow API.\nRun with: npx newman run <collection> -e <env>",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [],
	"item": [
		{
			"name": "00 — Setup",
			"item": [
				{
					"name": "Health Check",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('status is 200', function () { pm.response.to.have.status(200); });",
									"pm.test('Content-Type is JSON', function () { pm.response.to.be.json; });"
								]
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [
							{ "key": "Accept", "value": "application/json" }
						],
						"url": {
							"raw": "{{base_url}}/api/v1/health",
							"host": ["{{base_url}}"],
							"path": ["api", "v1", "health"]
						}
					},
					"response": []
				},
				{
					"name": "Generate Owner Credentials",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var ts = Date.now();",
									"var email = 'kan20-owner-' + ts + '@example.com';",
									"var password = 'PostmanPass123!';",
									"pm.environment.set('kan20_owner_email', email);",
									"pm.environment.set('kan20_owner_password', password);",
									"console.log('KAN-20 Owner email: ' + email);"
								]
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [
							{ "key": "Accept", "value": "application/json" }
						],
						"url": {
							"raw": "{{base_url}}/api/v1/health",
							"host": ["{{base_url}}"],
							"path": ["api", "v1", "health"]
						}
					},
					"response": []
				},
				{
					"name": "Register Owner",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('status is 201', function () { pm.response.to.have.status(201); });",
									"pm.test('Content-Type is JSON', function () { pm.response.to.be.json; });"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" },
							{ "key": "Accept", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"KAN-20 Postman Test Owner\",\n  \"email\": \"{{kan20_owner_email}}\",\n  \"password\": \"{{kan20_owner_password}}\",\n  \"password_confirmation\": \"{{kan20_owner_password}}\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/v1/auth/register",
							"host": ["{{base_url}}"],
							"path": ["api", "v1", "auth", "register"]
						}
					},
					"response": []
				},
				{
					"name": "Login Owner",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('status is 200', function () { pm.response.to.have.status(200); });",
									"pm.test('Content-Type is JSON', function () { pm.response.to.be.json; });",
									"var res = pm.response.json();",
									"if (res.token) { pm.environment.set('kan20_owner_token', res.token); }"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" },
							{ "key": "Accept", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"{{kan20_owner_email}}\",\n  \"password\": \"{{kan20_owner_password}}\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/v1/auth/login",
							"host": ["{{base_url}}"],
							"path": ["api", "v1", "auth", "login"]
						}
					},
					"response": []
				}
			]
		},
		{
			"name": "01 — Trigger Analysis",
			"item": [
				{
					"name": "Create Offer (201 Created)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('status is 201', function () { pm.response.to.have.status(201); });",
									"var res = pm.response.json();",
									"if (res.data && res.data.offer) { pm.environment.set('kan20_offer_id', String(res.data.offer.id)); }"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" },
							{ "key": "Accept", "value": "application/json" },
							{ "key": "Authorization", "value": "Bearer {{kan20_owner_token}}", "type": "text" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"KAN-20 Test Offer\",\n  \"description\": \"Offre de test pour l'analyse IA\",\n  \"destination_url\": \"https://example.com/offer\",\n  \"payout\": \"25.00\",\n  \"status\": \"active\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/v1/offers",
							"host": ["{{base_url}}"],
							"path": ["api", "v1", "offers"]
						}
					},
					"response": []
				},
				{
					"name": "Request Analysis — 202 Accepted",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('status is 202', function () { pm.response.to.have.status(202); });",
									"pm.test('Content-Type is JSON', function () { pm.response.to.be.json; });",
									"var res = pm.response.json();",
									"pm.test('has data envelope', function () { pm.expect(res.data).to.have.property('id'); });",
									"pm.test('data status is pending', function () { pm.expect(res.data.status).to.equal('pending'); });",
									"pm.test('data offer_id matches', function () { pm.expect(String(res.data.offer_id)).to.equal(pm.environment.get('kan20_offer_id')); });"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Accept", "value": "application/json" },
							{ "key": "Authorization", "value": "Bearer {{kan20_owner_token}}", "type": "text" }
						],
						"url": {
							"raw": "{{base_url}}/api/v1/offers/{{kan20_offer_id}}/analyze",
							"host": ["{{base_url}}"],
							"path": ["api", "v1", "offers", "{{kan20_offer_id}}", "analyze"]
						}
					},
					"response": []
				}
			]
		},
		{
			"name": "02 — Retrieve Analysis",
			"item": [
				{
					"name": "Get Analysis — 200 OK (or 404 if not yet completed)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('status is 200 or 404', function () { pm.expect([200, 404]).to.include(pm.response.code); });"
								]
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [
							{ "key": "Accept", "value": "application/json" },
							{ "key": "Authorization", "value": "Bearer {{kan20_owner_token}}", "type": "text" }
						],
						"url": {
							"raw": "{{base_url}}/api/v1/offers/{{kan20_offer_id}}/analysis",
							"host": ["{{base_url}}"],
							"path": ["api", "v1", "offers", "{{kan20_offer_id}}", "analysis"]
						}
					},
					"response": []
				}
			]
		},
		{
			"name": "03 — Authorization",
			"item": [
				{
					"name": "Guest Trigger Analysis → 401",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('status is 401', function () { pm.response.to.have.status(401); });"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Accept", "value": "application/json" }
						],
						"url": {
							"raw": "{{base_url}}/api/v1/offers/{{kan20_offer_id}}/analyze",
							"host": ["{{base_url}}"],
							"path": ["api", "v1", "offers", "{{kan20_offer_id}}", "analyze"]
						}
					},
					"response": []
				},
				{
					"name": "Guest Get Analysis → 401",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('status is 401', function () { pm.response.to.have.status(401); });"
								]
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [
							{ "key": "Accept", "value": "application/json" }
						],
						"url": {
							"raw": "{{base_url}}/api/v1/offers/{{kan20_offer_id}}/analysis",
							"host": ["{{base_url}}"],
							"path": ["api", "v1", "offers", "{{kan20_offer_id}}", "analysis"]
						}
					},
					"response": []
				}
			]
		},
		{
			"name": "04 — Error Handling",
			"item": [
				{
					"name": "Non-Existent Offer → 404",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('status is 404', function () { pm.response.to.have.status(404); });"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Accept", "value": "application/json" },
							{ "key": "Authorization", "value": "Bearer {{kan20_owner_token}}", "type": "text" }
						],
						"url": {
							"raw": "{{base_url}}/api/v1/offers/999999/analyze",
							"host": ["{{base_url}}"],
							"path": ["api", "v1", "offers", "999999", "analyze"]
						}
					},
					"response": []
				},
				{
					"name": "Get Non-Existent Analysis → 404",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('status is 404', function () { pm.response.to.have.status(404); });"
								]
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [
							{ "key": "Accept", "value": "application/json" },
							{ "key": "Authorization", "value": "Bearer {{kan20_owner_token}}", "type": "text" }
						],
						"url": {
							"raw": "{{base_url}}/api/v1/offers/999999/analysis",
							"host": ["{{base_url}}"],
							"path": ["api", "v1", "offers", "999999", "analysis"]
						}
					},
					"response": []
				}
			]
		}
	]
}
